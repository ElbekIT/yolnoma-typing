rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // SECURITY UTILITY FUNCTIONS
    // -------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidWpm(val) {
      return val is number && val >= 0 && val <= 260;
    }

    function isValidAccuracy(val) {
      return val is number && val >= 0 && val <= 100;
    }

    function isValidScore(val) {
      return val is number && val >= 0 && val <= 10000000;
    }

    function isRecentTimestamp(ts) {
      return ts is number && ts > 0 && ts <= request.time.toMillis() + 60000;
    }

    // -------------------------------------------------------------
    // 1. USERS COLLECTION
    // -------------------------------------------------------------
    match /users/{userId} {
      // Public profile data is readable for leaderboards & user lookups
      allow read: if true;

      // Users can only create and mutate their own profile with strict sanity checks
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && (!('highestWpm' in request.resource.data) || isValidWpm(request.resource.data.highestWpm))
        && (!('averageWpm' in request.resource.data) || isValidWpm(request.resource.data.averageWpm))
        && (!('highestAccuracy' in request.resource.data) || isValidAccuracy(request.resource.data.highestAccuracy))
        && (!('level' in request.resource.data) || (request.resource.data.level is number && request.resource.data.level >= 1 && request.resource.data.level <= 100))
        && (!('xp' in request.resource.data) || (request.resource.data.xp is number && request.resource.data.xp >= 0 && request.resource.data.xp <= 5000000))
        && (!('totalTests' in request.resource.data) || (request.resource.data.totalTests is number && request.resource.data.totalTests >= 0));

      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && (!('highestWpm' in request.resource.data) || isValidWpm(request.resource.data.highestWpm))
        && (!('averageWpm' in request.resource.data) || isValidWpm(request.resource.data.averageWpm))
        && (!('highestAccuracy' in request.resource.data) || isValidAccuracy(request.resource.data.highestAccuracy))
        && (!('level' in request.resource.data) || (request.resource.data.level is number && request.resource.data.level >= 1 && request.resource.data.level <= 100))
        && (!('xp' in request.resource.data) || (request.resource.data.xp is number && request.resource.data.xp >= 0 && request.resource.data.xp <= 5000000))
        && (!('totalTests' in request.resource.data) || (request.resource.data.totalTests is number && request.resource.data.totalTests >= 0));

      allow delete: if isOwner(userId);
    }

    // -------------------------------------------------------------
    // 2. 1V1 BATTLE ROOMS
    // -------------------------------------------------------------
    match /battle_rooms/{roomId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && (
          (request.resource.data.host is map && request.resource.data.host.id == request.auth.uid) ||
          (request.resource.data.hostId == request.auth.uid)
        )
        && request.resource.data.status in ['waiting', 'ready', 'racing', 'finished']
        && (!('host' in request.resource.data) || !('wpm' in request.resource.data.host) || isValidWpm(request.resource.data.host.wpm))
        && (!('host' in request.resource.data) || !('accuracy' in request.resource.data.host) || isValidAccuracy(request.resource.data.host.accuracy));

      allow update: if isAuthenticated()
        && (
          (resource.data.host is map && resource.data.host.id == request.auth.uid) ||
          (resource.data.hostId == request.auth.uid) ||
          (resource.data.guest == null) ||
          (resource.data.guestId == null) ||
          (resource.data.guest is map && resource.data.guest.id == request.auth.uid) ||
          (resource.data.guestId == request.auth.uid)
        )
        && (!('host' in request.resource.data) || !('wpm' in request.resource.data.host) || isValidWpm(request.resource.data.host.wpm))
        && (!('guest' in request.resource.data) || request.resource.data.guest == null || !('wpm' in request.resource.data.guest) || isValidWpm(request.resource.data.guest.wpm));

      allow delete: if isAuthenticated() && (
        (resource.data.host is map && resource.data.host.id == request.auth.uid) ||
        (resource.data.hostId == request.auth.uid)
      );
    }

    // -------------------------------------------------------------
    // 3. SPACE BATTLE LEADERBOARD SCORES
    // -------------------------------------------------------------
    match /space_scores/{scoreId} {
      allow read: if true;

      // Only authenticated users can submit their own score with anti-cheat bounds
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && isValidScore(request.resource.data.score)
        && request.resource.data.wave is number && request.resource.data.wave >= 1 && request.resource.data.wave <= 200
        && isValidAccuracy(request.resource.data.accuracy)
        && (!('wpm' in request.resource.data) || isValidWpm(request.resource.data.wpm))
        && (!('enemiesKilled' in request.resource.data) || (request.resource.data.enemiesKilled is number && request.resource.data.enemiesKilled >= 0))
        && (!('createdAt' in request.resource.data) || isRecentTimestamp(request.resource.data.createdAt));

      // Leaderboard score history records are strictly immutable
      allow update, delete: if false;
    }

    // -------------------------------------------------------------
    // 4. SENTENCE TRAINER SCORES
    // -------------------------------------------------------------
    match /sentence_scores/{scoreId} {
      allow read: if true;

      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && isValidScore(request.resource.data.score)
        && isValidWpm(request.resource.data.wpm)
        && isValidAccuracy(request.resource.data.accuracy)
        && (!('sentencesCompleted' in request.resource.data) || (request.resource.data.sentencesCompleted is number && request.resource.data.sentencesCompleted >= 0))
        && (!('createdAt' in request.resource.data) || isRecentTimestamp(request.resource.data.createdAt));

      // Immutable score entries
      allow update, delete: if false;
    }

    // -------------------------------------------------------------
    // 5. INDIVIDUAL TEST RESULTS
    // -------------------------------------------------------------
    match /test_results/{resultId} {
      allow read: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid) ||
        (resource.data.uid == request.auth.uid)
      );

      allow create: if isAuthenticated()
        && (
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.uid == request.auth.uid
        )
        && isValidWpm(request.resource.data.wpm)
        && isValidAccuracy(request.resource.data.accuracy)
        && (!('timestamp' in request.resource.data) || isRecentTimestamp(request.resource.data.timestamp));

      allow update, delete: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid) ||
        (resource.data.uid == request.auth.uid)
      );
    }

    // -------------------------------------------------------------
    // 6. DEFAULT DENY ALL OTHER ACCESS
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
